---
import FeaturedLinkCard from '../components/FeaturedLinkCard.astro';
const featuredLink = [
  {
    href: '/about',
    title: 'Mi Portafolio',
    description: 'Learn more about us.',
    icon: 'mdi:briefcase',
  },
  {
    href: '/blog',
    title: 'Latest Video',
    description: 'Read our latest posts.',
    icon: 'mdi:briefcase',

  },
    {
    href: '/blog',
    title: 'Book a Call',
    description: 'Read our latest posts.',
    icon: 'mdi:briefcase',
  },

]
---
<h2 class="section-title">Link destacados</h2>

<section class="featured-link-section">
<div class="featured-list">
{
  featuredLink.map(link => (
    <FeaturedLinkCard 
      url={link.href} 
      title={link.title} 
      description={link.description} 
      icon={link.icon} 
    />
  ))
}
</div>

</section>

<style>
  .featured-link-section {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 50%;
    padding: 1rem 1.25rem;
    text-decoration: none;
    border-radius: 2rem;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .section-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: white;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;

  }
  .featured-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

</style>
