---
import { Icon } from "astro-icon/components";

const { title, url, icon } = Astro.props;
---


<a href={url} class="link-card ">
  <Icon name={icon} />
  <span class="title">{title}</span>
</a>

<style>
  .link-card {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background-color: #302839;
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    border-radius: 2rem;
    width: 100%;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .link-card:hover {
    background-color: #3e3249;
    outline: 2px solid #7F13EC;
    outline-offset: 2px;
  }
  .title {
    text-align: center;

  }
</style>