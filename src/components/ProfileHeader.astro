---
const profileData = {
  name: "Lizeth Victoria Franco",
  bio: "Frontend Developer",
  tagline: "Crafting seamless web experiences",
}
import { Image } from "astro:assets";
import Profile from '../images/profile.png';
---

<header class="profile-header">
  <Image 
    class="profile-image"
    src={Profile}
    alt="Profile picture of Lizeth Victoria Franco"
    width={128}
    height={128}
  />
  <h1 class="name">{profileData.name}</h1>
  <p class="bio">{profileData.bio}</p>
  <p class="tagline">{profileData.tagline}</p>
</header>


<style>
  .profile-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 2rem;
    gap: 0.5rem;
    padding: 0 1rem;
  }
  .profile-image {
    border-radius: 50%;
  }
  .name {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
  }
  .tagline {
    font-size: 1rem;
    font-weight: 400;
    color: #AB9DB9;
  }
  .bio {
    font-size: 0.75rem;
    font-weight: 400;
    color: #E0CFEA;
  }
</style>