---
import LinkCard from "./LinkCard.astro"

const link = [
  {
    title: "Follow me on X",
    url: "https://twitter.com",
    icon: "mdi:twitter"
  },
  {
    title: "Connect on LinkedIn",
    url: "https://linkedin.com",
    icon: "mdi:linkedin"
  },
  {
    title: "Read my Medium articles",
    url: "https://medium.com",
    icon: "mdi:medium"
  },
  {
    title: "Visit my Website",
    url: "https://github.com",
    icon: "mdi:github"
  },


]

---
<h2 class="section-title">Todos mis links</h2>
<section class="all-links-sections">
{
  link.map(({ title, url, icon }) => (
    <LinkCard title={title} url={url} icon={icon} />
  ))
}
</section>

<style>
  .all-links-sections {
    width: 50%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    justify-content: center;
    margin-top: 2rem;
  }
  .section-title
  {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: .5rem;
  }
</style>
